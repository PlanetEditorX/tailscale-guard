#!/bin/bash
# tailscale-guard cmd/main — 守护进程启停控制
# 用法: main {start|stop|restart|status}

PKG_NAME="tailscale-guard"
PKG_VAR="/vol1/@appdata/${PKG_NAME}"
APP_DEST="/vol1/@appcenter/${PKG_NAME}"
PID_FILE="${PKG_VAR}/guard.pid"
LOG_FILE="${PKG_VAR}/guard.log"
GUARD_SCRIPT="${APP_DEST}/app/guard.sh"

export TRIM_PKGVAR="${PKG_VAR}"
export TRIM_APPDEST="${APP_DEST}"
export TRIM_PKGNAME="${PKG_NAME}"
export TRIM_APPNAME="${PKG_NAME}"

mkdir -p "${PKG_VAR}"

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') [main] $1" >> "${LOG_FILE}"; }

is_running() {
    [ -f "${PID_FILE}" ] || return 1
    local pid; pid=$(head -n1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

start_guard() {
    if is_running; then log_msg "guard already running"; return 0; fi
    log_msg "starting guard daemon..."
    nohup bash "${GUARD_SCRIPT}" >> "${LOG_FILE}" 2>&1 &
    pid=$!
    printf '%s' "$pid" > "${PID_FILE}"
    sleep 1
    if is_running; then log_msg "guard started pid=$!"; return 0
    else log_msg "guard failed to start"; rm -f "${PID_FILE}"; return 1; fi
}

stop_guard() {
    if ! is_running; then log_msg "guard not running"; rm -f "${PID_FILE}"; return 0; fi
    local pid; pid=$(head -n1 "${PID_FILE}" | tr -d '[:space:]')
    log_msg "stopping guard pid=${pid}..."
    kill -TERM "${pid}" 2>/dev/null
    local i=0
    while kill -0 "${pid}" 2>/dev/null && [ $i -lt 15 ]; do sleep 1; i=$((i+1)); done
    if kill -0 "${pid}" 2>/dev/null; then kill -KILL "${pid}" 2>/dev/null; sleep 1; fi
    rm -f "${PID_FILE}"
    log_msg "guard stopped"
}

case "$1" in
    start)   start_guard; exit $? ;;
    stop)    stop_guard; exit $? ;;
    restart) stop_guard; sleep 1; start_guard; exit $? ;;
    status)  is_running && { echo "running"; exit 0; } || { echo "stopped"; exit 3; } ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac