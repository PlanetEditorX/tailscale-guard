#!/bin/bash
# 安装后回调：根据安装向导收集的参数生成 guard.conf
# 运行环境由 fnOS 注入 wizard_* 变量（来自 wizard/install 的定义）
PKG_VAR="/vol1/@appdata/tailscale-guard"
mkdir -p "${PKG_VAR}"

# 向导字段兜底默认值（向导未提交时也能生成可用配置）
[ -z "$wizard_sentinel" ]        && wizard_sentinel="192.168.1.30"
[ -z "$wizard_start_condition" ] && wizard_start_condition="all_offline"
[ -z "$wizard_stop_condition" ]  && wizard_stop_condition="any_online"

# 生成初始配置文件
cat > "${PKG_VAR}/guard.conf" <<CONF
SENTINELS=${wizard_sentinel}
NORMAL_INTERVAL=600
RETRY_INTERVAL=180
START_THRESHOLD=3
START_CONDITION=${wizard_start_condition}
STOP_THRESHOLD=1
STOP_CONDITION=${wizard_stop_condition}
EFFECTIVE_TIME=${wizard_effective_time}
LAN_IFACE=enp6s18
CONF

exit 0
